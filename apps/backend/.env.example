NODE_ENV=development
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

####################################################################
Variables de entorno para la base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario
DB_PASSWORD=contraseña
DB_NAME=restaurante_sv
DB_SSL=true

# Connection String para Prisma ORM
DATABASE_URL="postgresql://postgres:tuContraseña@localhost:5432/restaurante_sv?schema=public"

#####################################################################
# Variables de entorno para la autenticación y CORS
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=secreto
INTERNAL_GATEWAY_TOKEN=

##############################################################333
# PHP CONFIGURATION
GATEWAY_PORT=8080
BACKEND_INTERNAL_URL=http://127.0.0.1:3000

